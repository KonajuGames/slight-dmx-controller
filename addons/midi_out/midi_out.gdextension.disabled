[configuration]

entry_symbol = "midi_out_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/midi_out/bin/libmidi_out.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/midi_out/bin/libmidi_out.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/midi_out/bin/libmidi_out.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/midi_out/bin/libmidi_out.linux.template_release.x86_64.so"
macos.debug = "res://addons/midi_out/bin/libmidi_out.macos.template_debug.dylib"
macos.release = "res://addons/midi_out/bin/libmidi_out.macos.template_release.dylib"

[configuration]

entry_symbol = "video_rec_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/video_rec/bin/libvideo_rec.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/video_rec/bin/libvideo_rec.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/video_rec/bin/libvideo_rec.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/video_rec/bin/libvideo_rec.linux.template_release.x86_64.so"
macos.debug = "res://addons/video_rec/bin/libvideo_rec.macos.template_debug.dylib"
macos.release = "res://addons/video_rec/bin/libvideo_rec.macos.template_release.dylib"

#!/usr/bin/env python
# Build the "native" GDExtension: every optional native feature (USB DMX
# output, MP4 video recording, fast song analysis, native MIDI output,
# DNS-SD advertising) bundled into a single shared library, so the exported
# package ships one GDExtension instead of five.
#   python -m SCons platform=windows target=template_debug
#   python -m SCons platform=windows target=template_release
# godot_cpp=<path> points at a godot-cpp checkout (build.py fills this in).

godot_cpp = ARGUMENTS.get("godot_cpp", "godot-cpp")

# Build with C++ exceptions enabled. godot-cpp disables them by default, but
# RtMidi (src/midi_out/) reports errors by throwing RtMidiError -- including
# from its constructor, before an error callback could be installed -- and
# midi_output.cpp catches them so a vanished port or a missing ALSA sequencer
# can't take the app down. With exceptions disabled that code doesn't compile
# on gcc/clang (-fno-exceptions) and on MSVC catches without unwinding.
# Nothing lets an exception cross into Godot: every RtMidi call is caught in
# midi_output.cpp. Override with disable_exceptions=yes only if RtMidi goes.
ARGUMENTS.setdefault("disable_exceptions", "no")

env = SConscript(godot_cpp + "/SConstruct")

env.Append(CPPPATH=[
    "src/",
    "src/usb_dmx/",
    "src/video_rec/",
    "src/song_dsp/",
    "src/midi_out/",
    "src/mdns/",
    "third_party/video_rec/",
    "third_party/song_dsp/",
    "third_party/shine/",
])

# minimp4's SPS/PPS-id transcoder redefines minih264's bitstream helpers
# (bs_t, h264e_bs_*) unless told not to. We feed a single encoder that
# already emits correct ids, so turn it off — everywhere, since it changes
# struct layout (video_rec only; doesn't affect the other components).
env.Append(CPPDEFINES=["MINIMP4_TRANSCODE_SPS_ID=0"])

# minih264 / minimp4 / minimp3 / stb_vorbis are C; everything else (and the
# Godot glue) is C++.
sources = (
    Glob("src/*.cpp")
    + Glob("src/usb_dmx/*.cpp")
    + Glob("src/video_rec/*.cpp") + Glob("src/video_rec/*.c")
    + Glob("src/song_dsp/*.cpp") + Glob("src/song_dsp/*.c")
    + Glob("src/midi_out/*.cpp")
    + Glob("src/mdns/*.cpp")          # DNS-SD advertising (OS2L discovery)
    + Glob("third_party/shine/*.c")   # MP3 encoder, for video_rec's audio track
)

# RtMidi (src/midi_out/) picks its backend from these defines -- one native
# OS MIDI API per platform, always present on a stock install.
if env["platform"] == "windows":
    env.Append(CPPDEFINES=["__WINDOWS_MM__"])
    env.Append(LIBS=["winmm"])          # also: timeBeginPeriod / timeEndPeriod (usb_dmx)
    # COM, for song_dsp's Media Foundation decoder (Media Foundation itself
    # is loaded at run time -- see src/song_dsp/dec_os.cpp).
    env.Append(LIBS=["ole32"])
elif env["platform"] == "macos":
    env.Append(CPPDEFINES=["__MACOSX_CORE__"])
    env.Append(FRAMEWORKS=["CoreMIDI", "CoreFoundation", "CoreAudio",
                           "AudioToolbox"])     # song_dsp's AAC decoding (ExtAudioFile)
elif env["platform"] in ("linux", "android"):
    env.Append(CPPDEFINES=["__LINUX_ALSA__"])
    env.Append(LIBS=["asound", "pthread", "dl"])  # dl: usb_dmx's dlopen/dlsym

libname = "libnative{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary("bin/{}".format(libname), source=sources)

Default(library)

[configuration]

entry_symbol = "usb_dmx_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/usb_dmx/bin/libusb_dmx.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/usb_dmx/bin/libusb_dmx.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/usb_dmx/bin/libusb_dmx.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/usb_dmx/bin/libusb_dmx.linux.template_release.x86_64.so"
macos.debug = "res://addons/usb_dmx/bin/libusb_dmx.macos.template_debug.dylib"
macos.release = "res://addons/usb_dmx/bin/libusb_dmx.macos.template_release.dylib"
